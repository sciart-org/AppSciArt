{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint:*)",
      "Bash(npm run lint --prefix *)",
      "Bash(npm run lint:fix --prefix *)",
      "Bash(npx playwright test:*)",
      "Bash(npm test)",
      "Bash(npm test --prefix *)",
      "Bash(npm run test:watch)",
      "Bash(npm run test:watch --prefix *)",
      "Bash(npx eslint:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/log-step-after-commit.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/public-repo-guard.py"
          }
        ]
      }
    ]
  }
}
