const path = require('path');
require('dotenv-flow').config();

const env = process.env.NODE_ENV || 'development';

const SEEDERS_FOLDER_BY_ENV = {
  development: 'sample',
  'pre-production': 'sample',
  testing: 'testing',
  production: 'production'
};

module.exports = {
  'config': path.resolve(__dirname, 'src/config/config.cjs'),
  'models-path': path.resolve(__dirname, 'src/models'),
  'migrations-path': path.resolve(__dirname, 'src/migrations'),
  'seeders-path': path.resolve(__dirname, 'src/seeders', SEEDERS_FOLDER_BY_ENV[env])
};
