{
  "name": "appsciart-backend",
  "version": "1.0.0",
  "description": "AppSciArt backend project",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "cross-env NODE_ENV=production node src/server.js",
    "dev": "cross-env NODE_ENV=development node --watch src/server.js",
    "test": "cross-env NODE_ENV=testing echo \"Error: no test specified\" && exit 1",
    "test:dev": "cross-env NODE_ENV=testing node --watch src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:migrate": "cross-env NODE_ENV=development npx sequelize-cli db:migrate",
    "db:migrate:test": "cross-env NODE_ENV=testing npx sequelize-cli db:migrate",
    "db:seed": "cross-env NODE_ENV=development npx sequelize-cli db:seed:all",
    "db:seed:test": "cross-env NODE_ENV=testing npx sequelize-cli db:seed:all",
    "db:seed:undo": "cross-env NODE_ENV=development npx sequelize-cli db:seed:undo:all",
    "db:migration:create": "npx sequelize-cli migration:generate --name",
    "db:seed:create": "npx sequelize-cli seed:generate --name",
    "db:ui": "open-cli http://localhost:54323",
    "db:ui:test": "open-cli http://localhost:54323"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sciart-org/AppSciArt.git"
  },
  "keywords": [
    "asters",
    "sciart",
    "art",
    "science",
    "appsciart",
    "hackathon"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sciart-org/AppSciArt/issues"
  },
  "homepage": "https://github.com/sciart-org/AppSciArt#readme",
  "devDependencies": {
    "cross-env": "^10.1.0",
    "open-cli": "^9.0.0",
    "sequelize-cli": "^6.6.3",
    "standard": "17.1.2"
  },
  "eslintConfig": {
    "extends": "standard"
  },
  "dependencies": {
    "@google-cloud/local-auth": "^2.1.0",
    "@oas-tools/auth": "^1.1.0",
    "@oas-tools/core": "^3.1.0",
    "@supabase/supabase-js": "^2.49.8",
    "cls-hooked": "^4.2.2",
    "cors": "2.8.5",
    "dotenv": "16.5.0",
    "dotenv-flow": "^4.1.0",
    "ejs": "^3.1.10",
    "express": "5.1.0",
    "googleapis": "^105.0.0",
    "jwt-decode": "^4.0.0",
    "pg": "8.14.1",
    "pg-hstore": "2.3.4",
    "resend": "^6.3.0",
    "sequelize": "6.37.7",
    "socket.io": "^4.8.1",
    "zod": "3.24.3"
  }
}
