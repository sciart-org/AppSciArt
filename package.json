{
  "scripts": {
    "dev:back": "npm run dev --prefix backend",
    "dev:front": "npm run dev --prefix frontend",
    "dev": "npm run dev:back & npm run dev:front", 
    "test:back": "npm run test --prefix backend",
    "test:front": "npm run test --prefix frontend",
    "lint": "npm run lint --prefix backend && npm run lint --prefix frontend",
    "lint:fix": "npm run lint:fix --prefix backend && npm run lint:fix --prefix frontend",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  },
  "lint-staged": {
    "frontend/**/*.{js,jsx,ts,tsx}": [
      "npm run lint:fix --prefix frontend"
    ],
    "backend/**/*.js": [
      "npm run lint:fix --prefix backend"
    ]
  }
}
